.env
.env.*
!.env.example
.venv/
.local/
__pycache__/
.pytest_cache/
.ruff_cache/
dist/
*.pyc

# 运行配置与凭据只保存在各环境中；仅提交字段定义和脱敏示例。
/config/*
!/config/*.example.json
!/config/product_day.dataset.json
/evidence/*
!/evidence/.gitkeep

# 云部署目录仅跟踪模板和验证脚本，防止上传实际接入配置及备份。
/deploy/cloud/*
!/deploy/cloud/compose.yml
!/deploy/cloud/.env.example
!/deploy/cloud/nginx-location.conf
!/deploy/cloud/database-transfer.sh
!/deploy/cloud/test_deployment.py
!/deploy/cloud/verify-isolated-transfer.py
*.partial

# 历史测试产物不作为源码上传。
*.log
*.xml
*.png
/tests/**/browser-result.json
/tests/**/scale-result.json
/tests/**/pytest-*.txt

# 数据库备份、发布包、私钥及用户提供的文档不进入 Git。
*.dump
*.db
*.sqlite
*.sqlite3
*.backup
*.bak
*.sql.gz
*.zip
*.tar
*.tar.gz
*.pem
*.key
*.p12
*.pfx
*.docx
*.doc
Thumbs.db
.DS_Store
