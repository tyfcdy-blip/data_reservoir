# 本文件只提供空白配置。复制为同目录.env，权限600，不提交Git。
DS_APP_IMAGE=
DS_POSTGRES_IMAGE=postgres:17-bookworm
POSTGRES_USER=data_service
POSTGRES_PASSWORD=
# URL内的密码必须进行URL编码；数据库名必须是本次创建成功的恢复库名。
DS_DOCKER_DATABASE_URL=
# 必须复制原本机的加密密钥，否则旧数据源和模型配置无法解密。
DS_CONFIG_ENCRYPTION_KEY=
DS_ADMIN_USERNAME=admin
DS_ALLOWED_SOURCE_HOSTS=[]
# 不可用此开关替代停止worker；数据库保存的各表定时规则仍可能生效。
DS_SCHEDULE_ENABLED=false
DS_TRUSTED_PROXY_IPS=
