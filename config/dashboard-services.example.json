[
  {
    "slug": "ds_dashboard_summary",
    "name": "经营看板 · 经营概览",
    "dataset_slug": "ads_product_dashboard_daily",
    "definition": {
      "aggregates": [
        {
          "field": "pay_amount",
          "op": "sum",
          "alias": "totalSalesAmount"
        },
        {
          "field": "net_sales_amount",
          "op": "sum",
          "alias": "netSalesAmount"
        },
        {
          "field": "gross_profit",
          "op": "sum",
          "alias": "grossProfit"
        },
        {
          "field": "profit_amount",
          "op": "sum",
          "alias": "netProfit"
        },
        {
          "field": "net_goods_cost",
          "op": "sum",
          "alias": "goodsCost"
        },
        {
          "field": "promotion_cost",
          "op": "sum",
          "alias": "adSpend"
        },
        {
          "field": "platform_cost",
          "op": "sum",
          "alias": "platformFees"
        },
        {
          "field": "refund_amount",
          "op": "sum",
          "alias": "totalRefundAmount"
        },
        {
          "field": "sales_qty",
          "op": "sum",
          "alias": "unitsSold"
        },
        {
          "field": "ship_fee",
          "op": "sum",
          "alias": "shipFee"
        },
        {
          "field": "sales_fee",
          "op": "sum",
          "alias": "salesFee"
        },
        {
          "field": "custom_fee",
          "op": "sum",
          "alias": "customFee"
        },
        {
          "op": "count",
          "alias": "recordCount"
        }
      ],
      "formulas": [
        {
          "alias": "grossMargin",
          "expression": "grossProfit / netSalesAmount",
          "decimal_places": 6
        },
        {
          "alias": "netMargin",
          "expression": "netProfit / netSalesAmount",
          "decimal_places": 6
        },
        {
          "alias": "refundRate",
          "expression": "totalRefundAmount / totalSalesAmount",
          "decimal_places": 6
        },
        {
          "alias": "goodsCostShare",
          "expression": "goodsCost / netSalesAmount",
          "decimal_places": 6
        },
        {
          "alias": "adSpendRatio",
          "expression": "adSpend / netSalesAmount",
          "decimal_places": 6
        },
        {
          "alias": "platformFeesShare",
          "expression": "platformFees / netSalesAmount",
          "decimal_places": 6
        },
        {
          "alias": "shipFeeShare",
          "expression": "shipFee / netSalesAmount",
          "decimal_places": 6
        },
        {
          "alias": "salesFeeShare",
          "expression": "salesFee / netSalesAmount",
          "decimal_places": 6
        },
        {
          "alias": "customFeeShare",
          "expression": "customFee / netSalesAmount",
          "decimal_places": 6
        },
        {
          "alias": "listedCostTotal",
          "expression": "goodsCost + adSpend + platformFees + shipFee + salesFee + customFee",
          "decimal_places": 6
        }
      ],
      "require_complete": false
    },
    "allowed_filter_fields": [
      "channel",
      "shop_name",
      "owner_person"
    ],
    "max_limit": 1,
    "enabled": true,
    "revision": 0
  },
